{
  "info": {
    "_postman_id": "f8df5c1a-1db4-4c1e-9592-2c685ca00d52",
    "name": "Qualys API (VM/PC)",
    "description": "Community-maintained reference collection for Qualys API (VM/PC).\n\nCurrent coverage: shared authentication and IP asset operations. Additional VMDR and Policy Audit families will be added incrementally.\n\nAuthentication defaults to Basic HTTP authentication with {{username}} and {{password}}. For IdP JWT authentication, set {{accessToken}} in your local environment and change this collection's authentication type to Bearer Token.\n\nUse a Qualys API server URL without a trailing slash for {{baseUrl}}. Never commit credentials, access tokens, or tenant response data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Shared platform",
      "description": "Requests shared across the Qualys API (VM/PC) collection.",
      "item": [
        {
          "name": "Authentication",
          "description": "Source: Qualys API (VM and PA) User Guide v10.40, pages 25-35. Lifecycle reviewed against the official EOS/EOL timeline on 2026-09-20; no lifecycle date is published for these session endpoints.",
          "item": [
            {
              "name": "Session login",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "X-Requested-With",
                    "value": "{{xRequestedWith}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "key": "action",
                      "value": "login",
                      "description": "Required. Makes a session login request.",
                      "type": "text"
                    },
                    {
                      "key": "username",
                      "value": "{{username}}",
                      "description": "Required. Qualys user login.",
                      "type": "text"
                    },
                    {
                      "key": "password",
                      "value": "{{password}}",
                      "description": "Required. Qualys user password. Postman URL-encodes form values.",
                      "type": "text"
                    },
                    {
                      "key": "echo_request",
                      "value": "1",
                      "description": "Optional. Set to 1 to echo request parameter names and values in the XML response.",
                      "type": "text",
                      "disabled": true
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/2.0/fo/session/",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "2.0",
                    "fo",
                    "session",
                    ""
                  ]
                },
                "description": "Creates a Qualys API V2 session. A successful response sets a QualysSession cookie. Postman should retain that cookie for requests to the same API server during the active session.\n\nLifecycle: No published EOS/EOL date as of 2026-09-20."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Session login returned HTTP 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Session login response indicates success', function () {",
                      "  pm.expect(pm.response.text()).to.include('Logged in');",
                      "});"
                    ]
                  }
                }
              ],
              "response": []
            },
            {
              "name": "Session logout",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "X-Requested-With",
                    "value": "{{xRequestedWith}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "key": "action",
                      "value": "logout",
                      "description": "Required. Makes a session logout request.",
                      "type": "text"
                    },
                    {
                      "key": "echo_request",
                      "value": "1",
                      "description": "Optional. Set to 1 to echo request parameter names and values in the XML response.",
                      "type": "text",
                      "disabled": true
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/2.0/fo/session/",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "2.0",
                    "fo",
                    "session",
                    ""
                  ]
                },
                "description": "Closes the active Qualys API V2 session. Send this after completing session-authenticated requests in the same Postman session.\n\nLifecycle: No published EOS/EOL date as of 2026-09-20."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Session logout returned HTTP 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Session logout response indicates success', function () {",
                      "  pm.expect(pm.response.text()).to.include('Logged out');",
                      "});"
                    ]
                  }
                }
              ],
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Assets",
      "description": "Source: Qualys API (VM and PA) User Guide v10.40, pages 983-1118. Lifecycle reviewed 2026-09-20.",
      "item": [
        {
          "name": "IP addresses",
          "item": [
            {
              "name": "List IP addresses (GET)",
              "request": {
                "method": "GET",
                "header": [{"key": "X-Requested-With", "value": "{{xRequestedWith}}", "type": "text"}],
                "url": {"raw": "{{baseUrl}}/api/2.0/fo/asset/ip/?action=list", "host": ["{{baseUrl}}"], "path": ["api", "2.0", "fo", "asset", "ip", ""], "query": [
                  {"key": "action", "value": "list", "description": "Required. Lists IP addresses.", "type": "text"},
                  {"key": "echo_request", "value": "1", "description": "Optional. Echoes request parameters.", "type": "text", "disabled": true},
                  {"key": "ips", "value": "", "description": "Optional. Comma-separated IPs or ranges.", "type": "text", "disabled": true},
                  {"key": "network_id", "value": "", "description": "Optional. Custom network ID when Network Support is enabled.", "type": "text", "disabled": true},
                  {"key": "tracking_method", "value": "", "description": "Optional. IP, DNS, or NETBIOS.", "type": "text", "disabled": true},
                  {"key": "compliance_enabled", "value": "", "description": "Optional. 0 or 1; requires Policy Compliance access.", "type": "text", "disabled": true},
                  {"key": "certview_enabled", "value": "", "description": "Optional. 0 or 1; requires Certificate View availability.", "type": "text", "disabled": true}
                ]},
                "description": "Lists IP addresses. Lifecycle: No published EOS/EOL date as of 2026-09-20."
              },
              "response": []
            },
            {
              "name": "List IP addresses (POST)",
              "request": {
                "method": "POST",
                "header": [{"key": "X-Requested-With", "value": "{{xRequestedWith}}", "type": "text"}],
                "body": {"mode": "urlencoded", "urlencoded": [
                  {"key": "action", "value": "list", "description": "Required. Lists IP addresses.", "type": "text"},
                  {"key": "echo_request", "value": "1", "description": "Optional. Echoes request parameters.", "type": "text", "disabled": true},
                  {"key": "ips", "value": "", "description": "Optional. Comma-separated IPs or ranges.", "type": "text", "disabled": true},
                  {"key": "network_id", "value": "", "description": "Optional. Custom network ID.", "type": "text", "disabled": true},
                  {"key": "tracking_method", "value": "", "description": "Optional. IP, DNS, or NETBIOS.", "type": "text", "disabled": true},
                  {"key": "compliance_enabled", "value": "", "description": "Optional. 0 or 1.", "type": "text", "disabled": true},
                  {"key": "certview_enabled", "value": "", "description": "Optional. 0 or 1.", "type": "text", "disabled": true}
                ]},
                "url": "{{baseUrl}}/api/2.0/fo/asset/ip/",
                "description": "POST form equivalent of IP list. Lifecycle: No published EOS/EOL date as of 2026-09-20."
              },
              "response": []
            },
            {
              "name": "[CHANGE] Add IP addresses",
              "request": {
                "method": "POST",
                "header": [{"key": "X-Requested-With", "value": "{{xRequestedWith}}", "type": "text"}],
                "body": {"mode": "urlencoded", "urlencoded": [
                  {"key": "action", "value": "add", "description": "Required by Qualys. Disabled as a safety gate; enable only after setting allowTenantChanges=true.", "type": "text", "disabled": true},
                  {"key": "enable_vm", "value": "1", "description": "Required. 0 or 1; requires VM module.", "type": "text"},
                  {"key": "enable_pc", "value": "0", "description": "Required. 0 or 1; requires PC module.", "type": "text"},
                  {"key": "enable_sca", "value": "0", "description": "Required. 0 or 1; requires SCA module.", "type": "text"},
                  {"key": "ips", "value": "192.0.2.10", "description": "Required unless POSTing CSV raw data. IPs, ranges, or CIDR notation.", "type": "text"},
                  {"key": "echo_request", "value": "1", "description": "Optional. Echoes request parameters.", "type": "text", "disabled": true},
                  {"key": "tracking_method", "value": "", "description": "Optional. IP, DNS, or NETBIOS.", "type": "text", "disabled": true},
                  {"key": "owner", "value": "", "description": "Optional. Manager or permitted Unit Manager.", "type": "text", "disabled": true},
                  {"key": "ud1", "value": "", "description": "Optional user-defined field 1.", "type": "text", "disabled": true},
                  {"key": "ud2", "value": "", "description": "Optional user-defined field 2.", "type": "text", "disabled": true},
                  {"key": "ud3", "value": "", "description": "Optional user-defined field 3.", "type": "text", "disabled": true},
                  {"key": "comment", "value": "", "description": "Optional user-defined comment.", "type": "text", "disabled": true},
                  {"key": "ag_title", "value": "", "description": "Required for Unit Manager; otherwise invalid.", "type": "text", "disabled": true},
                  {"key": "enable_certview", "value": "", "description": "Optional. 0 or 1 when Certificate View is available.", "type": "text", "disabled": true}
                ]},
                "url": "{{baseUrl}}/api/2.0/fo/asset/ip/",
                "description": "WARNING: Changes the subscription. Set allowTenantChanges=true and enable action=add only after reviewing all values. Lifecycle: No published EOS/EOL date as of 2026-09-20. CSV raw-data upload is documented as an alternative to ips and will be added as a separate request variant."
              },
              "response": []
            },
            {
              "name": "[CHANGE] Update IP addresses",
              "request": {
                "method": "POST",
                "header": [{"key": "X-Requested-With", "value": "{{xRequestedWith}}", "type": "text"}],
                "body": {"mode": "urlencoded", "urlencoded": [
                  {"key": "action", "value": "update", "description": "Required by Qualys. Disabled as a safety gate; enable only after setting allowTenantChanges=true.", "type": "text", "disabled": true},
                  {"key": "ips", "value": "192.0.2.10", "description": "Required unless POSTing CSV raw data. IPs, ranges, or CIDR notation.", "type": "text"},
                  {"key": "echo_request", "value": "1", "description": "Optional. Echoes request parameters.", "type": "text", "disabled": true},
                  {"key": "network_id", "value": "", "description": "Optional custom network ID.", "type": "text", "disabled": true},
                  {"key": "tracking_method", "value": "", "description": "Optional. IP, DNS, or NETBIOS; cannot change EC2 or AGENT tracking.", "type": "text", "disabled": true},
                  {"key": "host_dns", "value": "", "description": "Optional. Requires a single IP and matching DNS hostname.", "type": "text", "disabled": true},
                  {"key": "host_netbios", "value": "", "description": "Optional. Requires a single IP and matching NetBIOS hostname.", "type": "text", "disabled": true},
                  {"key": "owner", "value": "", "description": "Optional owner.", "type": "text", "disabled": true},
                  {"key": "ud1", "value": "", "description": "Optional user-defined field 1.", "type": "text", "disabled": true},
                  {"key": "ud2", "value": "", "description": "Optional user-defined field 2.", "type": "text", "disabled": true},
                  {"key": "ud3", "value": "", "description": "Optional user-defined field 3.", "type": "text", "disabled": true},
                  {"key": "comment", "value": "", "description": "Optional user-defined comment.", "type": "text", "disabled": true}
                ]},
                "url": "{{baseUrl}}/api/2.0/fo/asset/ip/",
                "description": "WARNING: Changes the subscription. Set allowTenantChanges=true and enable action=update only after reviewing all values. Lifecycle: No published EOS/EOL date as of 2026-09-20. CSV raw-data upload is documented as an alternative to ips and will be added as a separate request variant."
              },
              "response": []
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://YOUR-QUALYS-API-SERVER",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "xRequestedWith",
      "value": "Qualys API Toolkit",
      "type": "string"
    },
    {
      "key": "allowTenantChanges",
      "value": "false",
      "type": "string"
    }
  ]
}
